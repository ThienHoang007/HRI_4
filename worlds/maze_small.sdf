<?xml version="1.0"?>
<!-- Sinh tu gen_world.py. World nho hon maze goc de mo phong nhe hon (CPU render). -->
<sdf version='1.8'>
    <world name='maze_small'>
        <physics name='1ms' type='ignored'>
            <max_step_size>0.003</max_step_size>
            <real_time_factor>1</real_time_factor>
            <real_time_update_rate>1000</real_time_update_rate>
        </physics>
        <plugin name='ignition::gazebo::systems::Physics' filename='ignition-gazebo-physics-system' />
        <plugin name='ignition::gazebo::systems::UserCommands' filename='ignition-gazebo-user-commands-system' />
        <plugin name='ignition::gazebo::systems::SceneBroadcaster' filename='ignition-gazebo-scene-broadcaster-system' />
        <plugin name='ignition::gazebo::systems::Contact' filename='ignition-gazebo-contact-system' />
        <light name='sun' type='directional'>
            <cast_shadows>0</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <direction>-0.5 0.1 -0.9</direction>
        </light>
        <gravity>0 0 -9.8</gravity>
        <scene>
            <ambient>0.4 0.4 0.4 1</ambient>
            <background>0.7 0.7 0.7 1</background>
            <shadows>0</shadows>
        </scene>
        <model name='ground_plane'>
            <static>1</static>
            <link name='link'>
                <collision name='collision'><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
                <visual name='visual'>
                    <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
                    <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
                </visual>
            </link>
        </model>
        <model name='arena'>
            <static>true</static>
            <link name='north'>
                <pose>0 4 0.5 0 0 0</pose>
                <collision name='north_collision'><geometry><box><size>8.1 0.1 1</size></box></geometry></collision>
                <visual name='north_visual'>
                    <geometry><box><size>8.1 0.1 1</size></box></geometry>
                    <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0 0.1 0.2 1</diffuse></material>
                </visual>
            </link>
            <link name='south'>
                <pose>0 -4 0.5 0 0 0</pose>
                <collision name='south_collision'><geometry><box><size>8.1 0.1 1</size></box></geometry></collision>
                <visual name='south_visual'>
                    <geometry><box><size>8.1 0.1 1</size></box></geometry>
                    <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0 0.1 0.2 1</diffuse></material>
                </visual>
            </link>
            <link name='east'>
                <pose>4 0 0.5 0 0 0</pose>
                <collision name='east_collision'><geometry><box><size>0.1 8.1 1</size></box></geometry></collision>
                <visual name='east_visual'>
                    <geometry><box><size>0.1 8.1 1</size></box></geometry>
                    <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0 0.1 0.2 1</diffuse></material>
                </visual>
            </link>
            <link name='west'>
                <pose>-4 0 0.5 0 0 0</pose>
                <collision name='west_collision'><geometry><box><size>0.1 8.1 1</size></box></geometry></collision>
                <visual name='west_visual'>
                    <geometry><box><size>0.1 8.1 1</size></box></geometry>
                    <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0 0.1 0.2 1</diffuse></material>
                </visual>
            </link>
            <link name='partition_a'>
                <pose>-1.2 -1.75 0.5 0 0 0</pose>
                <collision name='partition_a_collision'><geometry><box><size>0.1 4.5 1</size></box></geometry></collision>
                <visual name='partition_a_visual'>
                    <geometry><box><size>0.1 4.5 1</size></box></geometry>
                    <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0 0.1 0.2 1</diffuse></material>
                </visual>
            </link>
            <link name='partition_b'>
                <pose>2.25 1.5 0.5 0 0 0</pose>
                <collision name='partition_b_collision'><geometry><box><size>3.5 0.1 1</size></box></geometry></collision>
                <visual name='partition_b_visual'>
                    <geometry><box><size>3.5 0.1 1</size></box></geometry>
                    <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0 0.1 0.2 1</diffuse></material>
                </visual>
            </link>
            <link name='box_1'>
                <pose>2.0 -2.2 0.5 0 0 0</pose>
                <collision name='box_1_collision'><geometry><box><size>1.0 1.0 1</size></box></geometry></collision>
                <visual name='box_1_visual'>
                    <geometry><box><size>1.0 1.0 1</size></box></geometry>
                    <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0 0.1 0.2 1</diffuse></material>
                </visual>
            </link>
            <link name='box_2'>
                <pose>-2.6 2.4 0.5 0 0 0</pose>
                <collision name='box_2_collision'><geometry><box><size>0.8 0.8 1</size></box></geometry></collision>
                <visual name='box_2_visual'>
                    <geometry><box><size>0.8 0.8 1</size></box></geometry>
                    <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0 0.1 0.2 1</diffuse></material>
                </visual>
            </link>
        </model>
    </world>
</sdf>
